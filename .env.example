# Copy to .env and fill in. .env is git-ignored.
# The default provider is the offline fake, so tests need none of these.

# fake (default) | openai
# "openai" means any server that speaks the OpenAI chat-completions API
# with tool calling: OpenAI, OpenRouter, Groq, Ollama, and so on.
LLM_PROVIDER=fake

# Used only when LLM_PROVIDER=openai.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Cap on tool-calling rounds for one customer message.
AGENT_MAX_STEPS=4
